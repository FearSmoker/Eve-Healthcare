# ══════════════════════════════════════════════════════════════════════════════
# EVE HEALTHCARE — Environment Configuration
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev, zero setup):
DATABASE_URL=sqlite:///./eve_healthcare.db

# PostgreSQL (production preferred):
# DATABASE_URL=postgresql://eve_user:eve_pass@localhost:5432/eve_healthcare

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=super-secret-eve-healthcare-jwt-token-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Webhook HMAC ──────────────────────────────────────────────────────────────
# Must be at least 16 characters.
WEBHOOK_SECRET=eve_webhook_secret_key_change_me_to_something_long

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── Redis ─────────────────────────────────────────────────────────────────────
# Start Redis locally:
#   macOS:  brew install redis && brew services start redis
#   Linux:  sudo apt install redis-server && sudo systemctl start redis
#   Docker: docker run -d -p 6379:6379 redis:7-alpine
#
# Three logical Redis databases (same instance, different DB numbers):
REDIS_URL=redis://localhost:6379/0         # DB 0: response cache
CACHE_ENABLED=true

# Cache TTLs (seconds)
CACHE_TTL_CENTRES_LIST=300    # 5 minutes
CACHE_TTL_CENTRE_DETAIL=600   # 10 minutes
CACHE_TTL_TESTS_LIST=600      # 10 minutes

# ── Celery ────────────────────────────────────────────────────────────────────
# Same Redis instance — different logical databases
CELERY_BROKER_URL=redis://localhost:6379/1   # DB 1: task queue
CELERY_RESULT_BACKEND=redis://localhost:6379/2  # DB 2: results
